{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    /* Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      // Resolve @notefig/shared to its TS source, mirroring the vite alias
      // (vite.config.ts). Without this, tsc falls through to the package's
      // `exports` → ./dist, forcing a shared build before every desktop tsc
      // (and breaking a fresh CI checkout). Keeping both resolvers on source
      // avoids stale-dist drift and the build coupling.
      "@notefig/shared": [
        "../shared/src/index.ts"
      ],
      "@notefig/shared/*": [
        "../shared/src/*/index.ts"
      ],
      "@notefig/agent": [
        "../agent/src/index.ts"
      ],
      // Same reason as @notefig/shared above, and this one is load-bearing:
      // @notefig/core's package `types` points at ./dist/index.d.ts, so
      // without this entry every desktop tsc needs core built first. It
      // worked only because a dist happened to exist in the author's tree.
      "@notefig/core": [
        "../core/src/index.ts"
      ],
      "@notefig/ui/*": [
        "../ui/src/*"
      ],
      "@notefig/widgets": [
        "../widgets/src/index.ts"
      ],
      "@notefig/widgets/*": [
        "../widgets/src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
