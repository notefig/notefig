{
  "extends": [
    "../../.fallowrc.json"
  ],
  "publicPackages": [
    "@notefig/desktop"
  ],
  "ignoreDependencies": [
    "@radix-ui/react-accordion",
    "@radix-ui/react-aspect-ratio",
    "@radix-ui/react-collapsible",
    "@radix-ui/react-hover-card",
    "@radix-ui/react-label",
    "@radix-ui/react-menubar",
    "@radix-ui/react-navigation-menu",
    "@radix-ui/react-progress",
    "@radix-ui/react-radio-group",
    "@radix-ui/react-scroll-area",
    "@radix-ui/react-slider",
    "@radix-ui/react-switch",
    "@radix-ui/react-tabs",
    "@radix-ui/react-toast",
    "@radix-ui/react-toggle",
    "@radix-ui/react-toggle-group",
    "@notefig/git",
    "@notefig/shared",
    "@tauri-apps/plugin-fs",
    "@tauri-apps/plugin-window-state",
    "@tanstack/query-core",
    "slate",
    "slate-react"
  ],
  "rules": {
    "unused-dependencies": "warn",
    "unlisted-dependencies": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/__tests__/**",
        "**/tests/**"
      ],
      "rules": {
        "unused-dependencies": "off"
      }
    }
  ],
  // The platform is injected: core hands each module the adapter the
  // composition root built, so app code reaches it through `ctx.use` /
  // `usePlatform()` and may import only the platform's contract (the
  // interface, its error types). Only the composition root (and tests)
  // import an adapter implementation.
  "boundaries": {
    "zones": [
      {
        "name": "tests",
        "patterns": [
          "src/testing/**",
          "src/**/__tests__/**",
          "src/**/*.test.ts",
          "src/**/*.test.tsx",
          "tests/**"
        ]
      },
      {
        "name": "platform-contract",
        "patterns": [
          "src/adapters/platform-adapter.interface.ts",
          "src/adapters/git-storage-host.ts"
        ]
      },
      { "name": "platform", "patterns": ["src/adapters/**"] },
      {
        "name": "composition",
        "patterns": [
          "src/main.tsx",
          "src/core/app-core.ts",
          "src/core/start-app.tsx"
        ]
      },
      { "name": "app", "patterns": ["src/**"] }
    ],
    "rules": [
      {
        "from": "app",
        "allow": ["app", "platform-contract"],
        "allowTypeOnly": ["platform"]
      },
      {
        "from": "composition",
        "allow": ["composition", "app", "platform-contract", "platform"]
      },
      {
        "from": "platform",
        "allow": ["platform", "platform-contract", "app"]
      },
      {
        "from": "platform-contract",
        "allow": ["platform-contract", "app"]
      },
      {
        "from": "tests",
        "allow": ["tests", "app", "platform-contract", "platform", "composition"]
      }
    ]
  }
}
