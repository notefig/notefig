{
  "$schema": "https://v2.tauri.app/schemas/config.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npx vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "productName": "Notefig",
  "version": "0.0.101",
  "identifier": "com.notefig.app",
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4RDc3NEY4MzNGQUM2NkQKUldSdHh2b3orSFRYU1A1amkwbUdoZzJ5VkJnSGRaUGJBcGtEeUJ5Z0tWd2hKUTNFTU9NUEdtdTEK",
      "endpoints": [
        "https://github.com/notefig/notefig/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "Notefig",
        "width": 1440,
        "height": 900,
        "zoomHotkeysEnabled": true,
        "minWidth": 1000,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "trafficLightPosition": { "x": 14, "y": 14 },
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$DOCUMENT/**", "$DOWNLOAD/**", "$DESKTOP/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
