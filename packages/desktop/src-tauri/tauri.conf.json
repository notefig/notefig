{
  "$schema": "https://v2.tauri.app/schemas/config.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npx vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "productName": "Metrists",
  "version": "0.0.2",
  "identifier": "com.metrists.dev",
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxNDc4MjlGMDY3QzkyMjYKUldRbWtud0duNEpIa1I4dXloNnl2U1A4YzVwc3VoMjZ1dGNvOXdxdERxeFkzY3RmNG0yRTNNNXAK",
      "endpoints": [
        "https://github.com/metrists/metrists/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "Metrists",
        "width": 1200,
        "height": 800,
        "zoomHotkeysEnabled": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
