{
  // Typechecks the site/ sources (and, transitively, the desktop modules
  // they import). Separate from tsconfig.json, which belongs to the Nextra
  // docs site. Mirrors ../desktop/tsconfig.json.
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../desktop/src/*"],
      "@notefig/shared": ["../shared/src/index.ts"],
      "@notefig/shared/*": ["../shared/src/*/index.ts"],
      // Kept in step with ../desktop/tsconfig.json by hand, like the entries
      // above: the Vite side of both builds shares one alias list
      // (sharedResolveAliases), but tsc has no such thing, so a workspace
      // package added there has to be added in BOTH tsconfigs or the site
      // build is the one that finds out.
      "@notefig/ui/*": ["../ui/src/*"],
      "@notefig/widgets": ["../widgets/src/index.ts"],
      "@notefig/widgets/*": ["../widgets/src/*"],
      // This package nests @types/react 19 (for Next), but the desktop app
      // typechecks against the workspace-root @types/react. Without pinning,
      // site/ files resolve 19 while the imported desktop modules resolve
      // the root copy, and the two RefObject/ReactNode shapes clash. Pin to
      // the same copy the desktop's own tsc uses.
      "react": ["../../node_modules/@types/react"],
      "react/*": ["../../node_modules/@types/react/*"],
      "react-dom": ["../../node_modules/@types/react-dom"],
      "react-dom/*": ["../../node_modules/@types/react-dom/*"]
    }
  },
  "include": ["site", "../desktop/src/vite-env.d.ts"]
}
