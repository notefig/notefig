{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      // Source, not dist — same reason as the desktop tsconfig: shared's
      // published output is CommonJS and building it before every typecheck
      // breaks a fresh checkout. @notefig/ui ships no dist at all (.tsx).
      "@notefig/shared": ["../shared/src/index.ts"],
      "@notefig/shared/*": ["../shared/src/*/index.ts"],
      "@notefig/ui/*": ["../ui/src/*"]
    }
  },
  "include": ["src"]
}
