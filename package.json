{
  "name": "notefig-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "./packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:shared": "npm run build -w packages/shared",
    "build:git": "npm run build -w packages/git",
    "build:cli": "npm run build -w packages/shared && npm run build -w packages/cli",
    "build:desktop": "npm run build -w packages/desktop",
    "dev:cli": "npm run dev -w packages/cli",
    "dev:desktop": "npm run tauri dev -w packages/desktop",
    "dev:marketing": "npm run dev -w packages/marketing",
    "test": "npm run test --workspaces --if-present",
    "test:cli": "npm run test -w packages/cli",
    "test:desktop": "npm run test:unit -w packages/desktop",
    "lint": "npm run lint -w packages/cli",
    "sync-themes": "rsync -av --delete --exclude-from=.rsync-exclude packages/themes/ packages/cli/dist/themes/",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules",
    "postinstall": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "execa": "^9.3.1",
    "fallow": "^3.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "zod": "^3.25.76"
  }
}
