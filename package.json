{
  "name": "metrists-monorepo",
  "private": true,
  "workspaces": [
    "./packages/*",
    "./themes/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:shared": "npm run build -w packages/shared",
    "build:cli": "npm run build -w packages/shared && npm run build -w packages/cli",
    "build:desktop": "npm run build -w packages/desktop",
    "dev:cli": "npm run dev -w packages/cli",
    "dev:desktop": "npm run dev -w packages/desktop",
    "test": "npm run test --workspaces",
    "test:cli": "npm run test -w packages/cli",
    "test:desktop": "npm run test:unit -w packages/desktop",
    "lint": "npm run lint --workspaces --if-present",
    "lint:cli": "npm run lint -w packages/cli",
    "lint:shared": "npm run lint -w packages/shared --if-present",
    "sync-themes": "rsync -av --delete --exclude-from=.rsync-exclude packages/themes/ packages/cli/dist/themes/",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "execa": "^9.3.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4"
  }
}
