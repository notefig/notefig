// agents.notefig.com: Linear issues → agents → pull requests. Setup and the one-time steps are in README.md.
// Everything account-specific is in `vars`; secrets come from GitHub through the release workflow.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "notefig-build-agents",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"routes": [{ "pattern": "agents.notefig.com", "custom_domain": true }],
	"observability": { "enabled": true },

	"vars": {
		"GITHUB_REPO": "notefig/notefig",
		"LINEAR_TEAM_KEY": "MET",
		// Testing mode: while set (e.g. "agent-test"), only issues with this label start an agent, and their PRs are drafts.
		"LINEAR_TEST_LABEL": "",
		// Set at deploy from the GitHub variable BUILD_AGENTS_APPROVERS, so no address is in the repository.
		"APPROVER_EMAILS": "",
		"TRUSTED_REVIEWERS": "greptile-apps[bot]",
		"TYPE_LABELS": "Bug=fix,Feature=feat,Improvement=improve",
		// Any model in pi-ai's catalog for the provider; through AI Gateway, so switching vendors is these two lines.
		"MODEL_PROVIDER": "cloudflare-ai-gateway",
		"MODEL_ID": "workers-ai/@cf/moonshotai/kimi-k2.7-code",
		"AI_GATEWAY_ID": "notefig-build-agents",
		// Set at deploy from the CLOUDFLARE_ACCOUNT_ID secret.
		"CLOUDFLARE_ACCOUNT_ID": "",
		"GIT_AUTHOR_NAME": "notefig-build-agent[bot]",
		"GIT_AUTHOR_EMAIL": "344640214+notefig-build-agent[bot]@users.noreply.github.com"
	},

	"durable_objects": {
		"bindings": [{ "name": "ISSUE_AGENT", "class_name": "IssueAgent" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["IssueAgent"] }],

	// The container each agent works in. `IssueAgent` starts it with internet off and intercepts the hosts it may reach.
	"containers": [
		{
			"class_name": "IssueAgent",
			"scheduling_policy": "durable_object",
			"images": { "workspace": { "dockerfile": "./Dockerfile" } }
		}
	],

	// No id: wrangler creates the namespace on the first deploy and keeps using it.
	"kv_namespaces": [{ "binding": "BRANCHES" }]
}
