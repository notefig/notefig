{
  "name": "notefig-build-agents",
  "version": "0.0.0",
  "private": true,
  "description": "agents.notefig.com: one Durable Object per Linear issue runs a Pi Durable agent that works in its own container and opens a pull request. Deliberately not an npm workspace; see README.md.",
  "type": "module",
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "dev": "npx wrangler@4.151.1 dev",
    "deploy": "npx wrangler@4.151.1 deploy",
    "bootstrap": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/bootstrap.ts",
    "create-github-app": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/create-github-app.ts"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.1",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261006.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
