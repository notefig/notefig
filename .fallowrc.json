{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "workspaces": {
    "patterns": ["packages/*", "packages/themes/*"]
  },
  "ignorePatterns": [
    "**/.contentlayer/**",
    "**/dist/**",
    "**/build/**",
    "**/*.d.ts",
    "**/*.generated.ts",
    "**/node_modules/**",
    "visual-texture-update/**"
  ],
  "ignoreDependencies": [
    "@tanstack/query-core",
    "class-variance-authority",
    "clsx",
    "lucide-react",
    "slate",
    "slate-react",
    "tailwind-merge",
    "tailwindcss-animate",
    "next-themes",
    "contentlayer2",
    "next-contentlayer2",
    "rehype-highlight",
    "remark-gfm",
    "vaul",
    "postcss-load-config"
  ],
  "ignoreExports": [
    { "file": "packages/desktop/src/components/ui/**", "exports": ["*"] },
    { "file": "packages/ui/src/**", "exports": ["*"] },
    { "file": "packages/marketing/components/ui/**", "exports": ["*"] },
    { "file": "packages/themes/**/components/ui/**", "exports": ["*"] }
  ],
  "usedClassMembers": [
    { "implements": "IPlatformAdapter", "members": ["*"] },
    { "extends": "BaseBrowserAdapter", "members": ["*"] },
    { "implements": "GitStorageHost", "members": ["*"] },
    { "implements": "Client", "members": ["*"] },
    { "implements": "AgentTransport", "members": ["*"] }
  ],
  "dynamicallyLoaded": [
    "packages/cli/commands/*.command.ts"
  ],
  "rules": {
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "unused-dependencies": "warn",
    "unused-dev-dependencies": "warn",
    "circular-dependencies": "error",
    "duplicate-exports": "error",
    "unused-files": "off",
    "unused-exports": "off",
    "unused-types": "off",
    // CSS styling rules, off repo-wide — reluctantly, and only because
    // fallow gives no narrower lever.
    //
    // The app's global stylesheet carries styling debt that predates this
    // gate: 14 classes no in-project markup references, a few duplicate
    // declaration blocks, some high-specificity selectors. Fallow attributes
    // styling findings to the WHOLE file when it changes, and — unlike
    // dead-code, health and dupes — styling has no baseline. So any edit to
    // styles.css, even appending an @source line, reports all of that debt as
    // newly introduced and fails the CI audit. (The CLI reports the same
    // findings as advisory and passes, so it only ever shows up in CI.)
    //
    // Scoping this to styles.css was the intent; `overrides.rules` does not
    // apply to styling codes, so a per-file entry parses and does nothing.
    // Re-scope these the moment fallow grows either a styling baseline or
    // styling-aware overrides. The real fix is deleting the dead classes,
    // which wants its own PR: they are low-confidence findings (list-style-*
    // and friends may be applied at runtime from constructed class names)
    // and need rendering checks, not a drive-by.
    "css-dead-surface": "off",
    "css-duplicate-block": "off",
    "css-selector-complexity": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "**/__tests__/**", "**/tests/**"],
      "rules": {
        "unused-exports": "off",
        "unused-types": "off",
        "unused-files": "off"
      }
    }
  ],
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 50,
    "ignore": [
      "**/*.generated.ts",
      "packages/desktop/src/testing/shim-transport.ts",
      "packages/ui/src/orb-loader.tsx"
    ]
  },
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "threshold": 10,
    "ignore": [
      "**/components/ui/**",
      "packages/ui/src/**",
      "packages/desktop/src/testing/shim-transport.ts"
    ],
    "skipLocal": false
  },
  "audit": {
    "gate": "new-only",
    "deadCodeBaseline": ".fallow/baselines/dead-code.json",
    "healthBaseline": ".fallow/baselines/health.json",
    "dupesBaseline": ".fallow/baselines/dupes.json"
  }
}
